@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

package Model as ModelPackage <<Rectangle>> {
Class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class AddressBook
Class ModelManager
Class UserPrefs

Class UniqueStudentList
Class Student
Class Name
Class AcademicLevel
Class Subject
Class Phone
Class Email
Class LessonNote
Class LessonDate
Class NoteText
Class StudentMatchesFilterPredicate
Class NameContainsKeywordsPredicate
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

AddressBook .up.|> ReadOnlyAddressBook
UserPrefs .up.|> ReadOnlyUserPrefs
ModelManager .up.|> Model

Model .left.> ReadOnlyAddressBook
Model .right.> ReadOnlyUserPrefs
Model ..> Student

ModelManager -left-> "1" AddressBook
ModelManager -right-> "1" UserPrefs
ModelManager --> "~* filtered" Student
StudentMatchesFilterPredicate ..> Student
NameContainsKeywordsPredicate ..> Student

AddressBook *--> "1" UniqueStudentList
ReadOnlyAddressBook --> "~* students" Student
UniqueStudentList --> "~* students" Student

Student *--> Name
Student *--> AcademicLevel
Student *--> "1..*" Subject
Student *--> Phone
Student *--> Email
Student *--> "*" LessonNote

LessonNote *--> LessonDate
LessonNote *--> Subject
LessonNote *--> NoteText
@enduml
